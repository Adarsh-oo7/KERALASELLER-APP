{
  "expo": {
    "name": "Kerala Sellers",
    "slug": "kerala-sellers",
    "scheme": "keralasellers",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#1A4845",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.keralasellers.app",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "Kerala Sellers uses the camera to scan product barcodes at the till.",
        "NSPhotoLibraryUsageDescription": "Kerala Sellers uses your photos for shop logos and product images.",
        "NSPhotoLibraryAddUsageDescription": "Kerala Sellers saves shop photos you choose."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "in.keralasellers.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Kerala Sellers uses the camera to scan product barcodes at the till.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kerala Sellers uses your photos for shop logos and product images."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableProguardInReleaseBuilds": false,
            "enableMinifyInReleaseBuilds": false,
            "extraProguardRules": "-keep class com.facebook.react.** { *; }"
          }
        }
      ],
      "./plugins/withAndroidPaymentQueries.js",
      "expo-sharing"
    ],
    "extra": {
      "privacyPolicyUrl": "https://www.keralasellers.in/privacy-policy",
      "termsUrl": "https://www.keralasellers.in/terms-and-conditions",
      "supportEmail": "keralasellers.in@gmail.com",
      "eas": {
        "projectId": "e81267cb-3458-4399-91e6-ac5cb723427b"
      }
    },
    "owner": "adarshbs"
  }
}
