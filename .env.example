# ============================================================
# Kerala Sellers App — Environment Variables Template
# Copy to .env and fill in real values
# NEVER commit .env or google-services.json to git
# ============================================================

# Backend API (production)
EXPO_PUBLIC_API_BASE_URL=https://api.keralasellers.in
EXPO_PUBLIC_API_URL=https://api.keralasellers.in

# App environment: 'production' | 'development'
EXPO_PUBLIC_APP_ENV=production

# EAS / Google Services (set as EAS Secret in dashboard, not here)
# GOOGLE_SERVICES_JSON=./google-services.json
